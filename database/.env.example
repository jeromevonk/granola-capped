# Copy to database/.env (gitignored) for the local docker Postgres used by
# docker-compose.yml and setup_test_db.sh. 
# Not used for prod/staging — those use backend-frontend/.env* with a real Aiven connection string.
POSTGRES_PASSWORD=my_postgresql_password

# Host port for the local Postgres (default 5433, so it can coexist with
# other Postgres containers on 5432). Must match PG_CONNECTION_STRING in
# backend-frontend/.env.local and vitest.integration.config.mjs.
# POSTGRES_PORT=5433
